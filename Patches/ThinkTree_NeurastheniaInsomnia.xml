<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- Add the custom "Insomnia Episode" mental state to Wander_OwnRoom's ConditionalMentalStates node,
       so pawns in this mental state will be routed into the "wander in own room" subtree (JobGiver_WanderOwnRoom),
       manifesting as uncontrollable wandering. The original node only recognizes defName=Wander_OwnRoom.
       Note: RimWorld think tree nodes all use <li> tags, differentiated by Class attribute, hence @Class matching. -->
  <Operation Class="PatchOperationAdd">
    <xpath>//ThinkTreeDef[defName='MentalStateNonCritical']//li[@Class='ThinkNode_ConditionalMentalStates'][states/li[text()='Wander_OwnRoom']]/states</xpath>
    <value>
      <li>NeurastheniaInsomnia</li>
    </value>
  </Operation>
</Patch>
