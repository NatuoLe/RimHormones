<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- Insert the "Strain Block" column into the Assign tab, after MedicalCare and before outfit.
       PatchOperationInsert defaults to order=Append: inserts after the matched node (as a sibling). -->
  <Operation Class="PatchOperationInsert">
    <xpath>Defs/PawnTableDef[defName="Assign"]/columns/li[text()="MedicalCare"]</xpath>
    <value>
      <li>GapTiny</li>
      <li>Hormones_StrainBlock</li>
    </value>
  </Operation>

</Patch>
