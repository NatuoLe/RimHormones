        <painOffset>0.15</painOffset>
        <capMods>
          <li><capacity>Hearing</capacity><postFactor>0.40</postFactor></li>
          <li><capacity>Consciousness</capacity><postFactor>0.80</postFactor></li>
        </capMods>
      </li>
