<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================
       透支损伤池（Strain Pool）
       按「触发活动类型」分类，同一器官来自不同活动是不同的 Hediff。
       参考文档：文档/Hediff/身体损伤.md

       字段映射说明（已按 RimWorld 1.6 核实）：
         · 能力（PawnCapacity）修正 → capMods + postFactor（乘算）
           可用能力：Manipulation / Moving / BloodPumping / Breathing /
                     Consciousness / Sight / Hearing / BloodFiltration /
                     Metabolism / Eating / Talking
         · 属性（Stat）修正 → statFactors（乘算）
           如 MoveSpeed / WorkSpeedGlobal / MentalBreakThreshold
         · 疼痛加算 → painOffset（正=加痛，负=减痛）
         · 饥饿速率 → HediffStage 直接字段 hungerRateFactor（非 stat）
         · md 中的 "SightRadius" 非原版属性，用能力 Sight 近似（postFactor）
         · md 中的 "Spine" 是身体部件、非能力，附着于 Arm/Leg 的 hediff
           无法直接修正脊柱，改用 Manipulation/Moving 代偿其联动损伤
       恢复机制：
         · Disappears  → HediffCompProperties_Disappears（固定时间自动消失）
         · 时间渐减    → HediffCompProperties_SeverityPerDay（severityPerDay 负值）
                        24 游戏小时 = 1 天，-0.36/day ≈ -0.015/h
       ============================================================ -->

  <!-- ============================================================
       一、肌肉劳损类（体力劳作触发）
       恢复：Disappears 60000 ticks（1 游戏天）
       ============================================================ -->

  <!-- 采矿/砍树/搬运等重体力：附着于 Arm/Leg（左右独立叠加） -->
  <HediffDef>
    <defName>LaborMuscleStrain</defName>
    <label>肌肉劳损</label>
    <description>长时间重体力劳作导致的肌肉透支，从疲劳发展到拉伤、撕裂。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1.0, 0.5, 0.25)</defaultLabelColor>
    <isBad>true</isBad>
    <makesAlert>false</makesAlert>
    <tendable>false</tendable>
    <maxSeverity>1.0</maxSeverity>
    <stages>
      <li>
        <label>肌肉疲劳</label>
        <minSeverity>0</minSeverity>
        <painOffset>0.02</painOffset>
        <capMods>
          <li><capacity>Manipulation</capacity><postFactor>0.95</postFactor></li>
          <li><capacity>Moving</capacity><postFactor>0.95</postFactor></li>
        </capMods>
      </li>
      <li>
        <label>肌肉拉伤</label>
        <minSeverity>0.4</minSeverity>
        <painOffset>0.08</painOffset>
        <capMods>
          <li><capacity>Manipulation</capacity><postFactor>0.85</postFactor></li>
          <li><capacity>Moving</capacity><postFactor>0.85</postFactor></li>
        </capMods>
      </li>
      <li>
        <label>肌肉撕裂</label>
        <minSeverity>0.75</minSeverity>
        <painOffset>0.20</painOffset>
        <capMods>
          <li><capacity>Manipulation</capacity><postFactor>0.70</postFactor></li>
          <li><capacity>Moving</capacity><postFactor>0.70</postFactor></li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

