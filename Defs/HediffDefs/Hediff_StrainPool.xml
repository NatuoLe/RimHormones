      </li>
      <li>
        <label>arrhythmia</label>
        <minSeverity>0.4</minSeverity>
        <capMods>
          <li><capacity>BloodPumping</capacity><postFactor>1.15</postFactor></li>
          <li><capacity>Breathing</capacity><postFactor>1.15</postFactor></li>
        </capMods>
      </li>
      <!-- [2026-08-02 re-enabled] xlsx marks "allowed to trigger", stage name myocardial ischemia, BloodPumping user confirmed ×0.80 -->
