    <isBad>true</isBad>
    <makesAlert>false</makesAlert>
    <tendable>false</tendable>
    <maxSeverity>1.0</maxSeverity>
    <stages>
      <li>
        <label>耳鸣</label>
        <minSeverity>0</minSeverity>
        <painOffset>0.02</painOffset>
        <capMods>
          <li><capacity>Hearing</capacity><postFactor>0.85</postFactor></li>
        </capMods>
      </li>
      <li>
        <label>听觉过敏</label>
        <minSeverity>0.4</minSeverity>
        <painOffset>0.08</painOffset>
        <capMods>
          <li><capacity>Hearing</capacity><postFactor>0.65</postFactor></li>
          <li><capacity>Consciousness</capacity><postFactor>0.95</postFactor></li>
        </capMods>
      </li>
      <li>
        <label>听力损伤</label>
