        <label>myocardial ischemia</label>
        <minSeverity>0.75</minSeverity>
        <capMods>
          <li><capacity>BloodPumping</capacity><postFactor>0.80</postFactor></li>
          <li><capacity>Breathing</capacity><postFactor>0.88</postFactor></li>
          <li><capacity>Consciousness</capacity><postFactor>0.85</postFactor></li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.36</severityPerDay>
      </li>
    </comps>
  </HediffDef>

