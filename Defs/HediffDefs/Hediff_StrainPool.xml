        <capMods>
          <li><capacity>Manipulation</capacity><postFactor>0.92</postFactor></li>
          <li><capacity>Moving</capacity><postFactor>0.97</postFactor></li>
        </capMods>
      </li>
      <li>
        <label>肩袖损伤</label>
        <minSeverity>0.4</minSeverity>
        <painOffset>0.10</painOffset>
        <capMods>
          <li><capacity>Manipulation</capacity><postFactor>0.80</postFactor></li>
          <li><capacity>Moving</capacity><postFactor>0.92</postFactor></li>
