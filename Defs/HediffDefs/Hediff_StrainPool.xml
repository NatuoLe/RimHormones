  <HediffDef>
    <defName>AuditoryStrain</defName>
    <label>auditory overload</label>
    <description>Overstimulation of hearing from sustained gunfire and explosions, progressing from tinnitus to hearing damage; inner ear vestibular damage also affects consciousness.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.85, 0.8, 0.5)</defaultLabelColor>
    <isBad>true</isBad>
    <makesAlert>false</makesAlert>
    <tendable>false</tendable>
    <!-- [2026-08-02] xlsx stage details mark third stage as "cannot trigger": capped at 0.74, severity never reaches 0.75 -->
    <maxSeverity>0.74</maxSeverity>
    <modExtensions>
      <li Class="Hormones.StrainHediffExt">
        <combatTriggered>true</combatTriggered>
        <onShoot>true</onShoot>
        <onMelee>false</onMelee>
        <onMeleeHitTaken>false</onMeleeHitTaken>
        <onAdrenalineBuildup>false</onAdrenalineBuildup>
        <severityTier>Moderate</severityTier>
      </li>
    </modExtensions>
    <stages>
      <li>
        <label>tinnitus</label>
        <minSeverity>0</minSeverity>
        <painOffset>0.02</painOffset>
        <capMods>
          <li><capacity>Hearing</capacity><postFactor>0.85</postFactor></li>
        </capMods>
      </li>
      <li>
        <label>hearing damage</label>
        <minSeverity>0.4</minSeverity>
        <painOffset>0.08</painOffset>
        <capMods>
          <li><capacity>Hearing</capacity><postFactor>0.65</postFactor></li>
          <li><capacity>Consciousness</capacity><postFactor>0.95</postFactor></li>
        </capMods>
      </li>
      <!-- [2026-08-02 disabled] xlsx stage details mark as "cannot trigger", maxSeverity 0.74 ensures this stage is never reached.
           To re-enable: restore the li below and set maxSeverity back to 1.0.
           Stage name: hearing damage; painOffset +0.15; capMods: Hearing ×0.40, Consciousness ×0.80
      <li>
        <label>hearing damage</label>
        <minSeverity>0.75</minSeverity>
        <painOffset>0.15</painOffset>
        <capMods>
          <li><capacity>Hearing</capacity><postFactor>0.40</postFactor></li>
          <li><capacity>Consciousness</capacity><postFactor>0.80</postFactor></li>
        </capMods>
      </li>
      -->
    </stages>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.29</severityPerDay>
      </li>
    </comps>
  </HediffDef>

  <!-- ============================================================
       Exhaustion (soft work block state marker, not an injury)
       Mechanism: Auto-applied by HormonesComponent when strain reserve (Need_MuscleStrain)
       drops below the set threshold; auto-removed when recovered to threshold+10% (hysteresis).
       Behavior (reworked 2026-08-01): acts only as a "state marker". Soft blocking is implemented
       by StrainWorkBlockPatches postfixing Pawn_WorkSettings.WorkGiversInOrder* getters —
       AI skips mining/hauling/construction/planting/hunting WorkGivers when scanning jobs,
       but does NOT mark as "unable" (work tab not grayed out);
       right-click manual priority assignment still works (analogous to research bench "forbid":
       doesn't lock ability, recovers anytime).
       ============================================================ -->
  <HediffDef>
    <defName>PhysiqueStrainExhausted</defName>
    <label>exhausted</label>
    <description>Physical reserve is depleted. Will not take on heavy physical work automatically (manual assignment still works). Rest or leisure recovers physical reserve.</description>
    <defaultLabelColor>(0.55, 0.75, 1.0)</defaultLabelColor>
    <isBad>true</isBad>
    <makesAlert>false</makesAlert>
    <tendable>false</tendable>
    <maxSeverity>1.0</maxSeverity>
    <stages>
      <li>
        <label>exhausted</label>
        <minSeverity>0</minSeverity>
      </li>
    </stages>
  </HediffDef>

</Defs>
