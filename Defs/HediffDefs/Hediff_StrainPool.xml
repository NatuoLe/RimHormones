<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================
       Strain Pool
       Categorized by "trigger activity type". Different activities on the same organ produce different Hediffs.
       Reference: docs/Hediff/body_injuries.md

       Field mapping (verified against RimWorld 1.6):
         · PawnCapacity mods → capMods + postFactor (multiplicative)
           Available: Manipulation / Moving / BloodPumping / Breathing /
                      Consciousness / Sight / Hearing / BloodFiltration /
                      Metabolism / Eating / Talking
         · Stat mods → statFactors (multiplicative)
           e.g. MoveSpeed / WorkSpeedGlobal / MentalBreakThreshold
         · Pain addition → painOffset (positive = more pain, negative = less)
         · Hunger rate → HediffStage field hungerRateFactor (not a stat)
         · "SightRadius" from md is not a vanilla stat; approximated via Sight capacity (postFactor)
         · "Spine" from md is a body part, not a capacity; hediffs attached to Arm/Leg
           Cannot directly modify spine; use Manipulation/Moving to compensate linked damage
       Recovery mechanisms:
         · Disappears → HediffCompProperties_Disappears (auto-removes after fixed time)
         · Time decay → HediffCompProperties_SeverityPerDay (negative severityPerDay)
                        24 game hours = 1 day, -0.36/day ≈ -0.015/h
       ============================================================ -->

  <!-- ============================================================
       I. Muscle Strain (triggered by physical labor)
       Recovery: Disappears 60000 ticks (1 game day)
       ============================================================ -->

  <!-- Heavy labor (mining/cutting/hauling): attached to Arm/Leg (left/right stack independently) -->
  <HediffDef>
    <defName>LaborMuscleStrain</defName>
    <label>muscle strain</label>
    <description>Muscle overexertion from prolonged heavy labor, progressing from fatigue to strain to tear.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1.0, 0.5, 0.25)</defaultLabelColor>
    <isBad>true</isBad>
    <makesAlert>false</makesAlert>
    <!-- [2026-08-02] xlsx overview: all injuries unified as "tendable = no" -->
    <tendable>false</tendable>
    <maxSeverity>1.0</maxSeverity>
    <modExtensions>
      <li Class="Hormones.StrainHediffExt">
        <combatTriggered>false</combatTriggered>
        <onShoot>false</onShoot>
        <onMelee>false</onMelee>
        <onMeleeHitTaken>false</onMeleeHitTaken>
        <onAdrenalineBuildup>false</onAdrenalineBuildup>
        <severityTier>Mild</severityTier>
      </li>
    </modExtensions>
    <stages>
      <li>
        <label>muscle fatigue</label>
        <minSeverity>0</minSeverity>
        <painOffset>0.02</painOffset>
        <capMods>
          <li><capacity>Manipulation</capacity><postFactor>0.95</postFactor></li>
          <li><capacity>Moving</capacity><postFactor>0.95</postFactor></li>
        </capMods>
      </li>
      <li>
        <label>muscle strain</label>
        <minSeverity>0.4</minSeverity>
        <painOffset>0.08</painOffset>
        <capMods>
          <li><capacity>Manipulation</capacity><postFactor>0.85</postFactor></li>
          <li><capacity>Moving</capacity><postFactor>0.85</postFactor></li>
        </capMods>
      </li>
      <li>
        <label>muscle tear</label>
        <minSeverity>0.75</minSeverity>
        <painOffset>0.20</painOffset>
        <capMods>
          <li><capacity>Manipulation</capacity><postFactor>0.70</postFactor></li>
          <li><capacity>Moving</capacity><postFactor>0.70</postFactor></li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

