<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- 神经衰弱心情（含体魄修正）。由 ThoughtWorker_NeurastheniaMood 在 pawn 带 CortisolNeurasthenia 时评估，
       stage 索引 = physiqueIdx（Frail=0 Average=1 Fit=2 Strong=3 Peak=4），心情 = 基础-5 + 体魄偏移。 -->
  <ThoughtDef>
    <defName>NeurastheniaMood</defName>
    <label>神经衰弱</label>
    <description>神经衰弱带来的持续低落情绪，身体素质越好的人对于神经衰弱的影响越轻。</description>
    <workerClass>Hormones.ThoughtWorker_NeurastheniaMood</workerClass>
    <stages>
      <li><label>严重的神经衰弱</label><description>体魄虚弱的神经衰弱症状</description><baseMoodEffect>-3</baseMoodEffect></li>
      <li><label>神经衰弱</label><description>体魄一般的神经衰弱症状</description><baseMoodEffect>-2</baseMoodEffect></li>
      <li><label>神经衰弱</label><description>体魄强健的神经衰弱症状</description><baseMoodEffect>-2</baseMoodEffect></li>
      <li><label>较弱的神经衰弱</label><description>体魄强壮的神经衰弱症状</description><baseMoodEffect>-2</baseMoodEffect></li>
      <li><label>微弱的神经衰弱</label><description>体魄巅峰的神经衰弱症状</description><baseMoodEffect>-1</baseMoodEffect></li>
    </stages>
  </ThoughtDef>
</Defs>
