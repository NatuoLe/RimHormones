<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- Neurasthenia mood (with physique modifier). Evaluated by ThoughtWorker_NeurastheniaMood when pawn has CortisolNeurasthenia,
       stage index = physiqueIdx (Frail=0 Average=1 Fit=2 Strong=3 Peak=4), mood = base -5 + physique offset. -->
  <ThoughtDef>
    <defName>NeurastheniaMood</defName>
    <label>neurasthenia</label>
    <description>Persistent low mood from neurasthenia. People with better physical condition are less affected.</description>
    <workerClass>Hormones.ThoughtWorker_NeurastheniaMood</workerClass>
    <stages>
      <li><label>severe neurasthenia</label><description>Neurasthenia symptoms with frail physique</description><baseMoodEffect>-3</baseMoodEffect></li>
      <li><label>neurasthenia</label><description>Neurasthenia symptoms with average physique</description><baseMoodEffect>-2</baseMoodEffect></li>
      <li><label>neurasthenia</label><description>Neurasthenia symptoms with fit physique</description><baseMoodEffect>-2</baseMoodEffect></li>
      <li><label>mild neurasthenia</label><description>Neurasthenia symptoms with strong physique</description><baseMoodEffect>-2</baseMoodEffect></li>
      <li><label>faint neurasthenia</label><description>Neurasthenia symptoms with peak physique</description><baseMoodEffect>-1</baseMoodEffect></li>
    </stages>
  </ThoughtDef>
</Defs>
