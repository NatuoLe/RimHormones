<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- ============================================================
       Exhaustion mood (reworked 2026-08-01: situational)
       Old: memory thought on strain trigger (Thought_Memory, 6h duration, stackable 12 times).
       New: situational (Thought_Situational) — activates when strain reserve <10%,
            non-stackable, no duration, only checks reserve level; auto-disappears above 10%.
       ============================================================ -->
  <ThoughtDef>
    <defName>MuscleStrainRest</defName>
    <label>exhausted</label>
    <description>So tired, want to rest.</description>
    <thoughtClass>Thought_Situational</thoughtClass>
    <workerClass>Hormones.ThoughtWorker_MuscleStrainRest</workerClass>
    <stages>
      <li><label>completely exhausted</label><description>I can't even lift my legs anymore.</description><baseMoodEffect>-2</baseMoodEffect></li>
    </stages>
  </ThoughtDef>

  <!-- ============================================================
       Body aches (new 2026-08-01)
       Activates when pawn has any strain/overexertion Hediff (Hediff_StrainPool.xml injury pool);
       auto-disappears when injuries recover. Situational, non-stackable, no duration.
       ============================================================ -->
  <ThoughtDef>
    <defName>StrainInjuryMood</defName>
    <label>body aches</label>
    <description>Strain injuries are aching.</description>
    <thoughtClass>Thought_Situational</thoughtClass>
    <workerClass>Hormones.ThoughtWorker_StrainInjuryMood</workerClass>
    <stages>
      <li><label>body aches</label><description>I think I just hurt myself.</description><baseMoodEffect>-3</baseMoodEffect></li>
    </stages>
  </ThoughtDef>
</Defs>
