<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- Insomnia episode triggered by neurasthenia: uncontrollable mental state, reuses WanderOwnRoom wandering behavior,
       fixed 2-hour duration (5000 ticks) then auto-recovers. Triggered by Need_Cortisol with forced:true,
       bypassing bedroom restriction; connected to Wander_OwnRoom subtree via ThinkTree patch.
       Fields strictly aligned with vanilla Wander_OwnRoom (only legal enums/fields like Misc). -->
  <MentalStateDef ParentName="BaseMentalState">
    <defName>NeurastheniaInsomnia</defName>
    <stateClass>MentalState_WanderOwnRoom</stateClass>
    <workerClass>MentalStateWorker_WanderOwnRoom</workerClass>
    <label>insomnia episode</label>
    <category>Misc</category>
    <colonistsOnly>true</colonistsOnly>
    <!-- Fixed 2-hour recovery: min=max=5000, recoveryMtbDays=-1 disables random recovery, age-based only -->
    <minTicksBeforeRecovery>5000</minTicksBeforeRecovery>
    <maxTicksBeforeRecovery>5000</maxTicksBeforeRecovery>
    <recoveryMtbDays>-1</recoveryMtbDays>
    <!-- Insomnia: sleep does not end the episode early -->
    <recoverFromSleep>false</recoverFromSleep>
    <blockNormalThoughts>true</blockNormalThoughts>
    <nameColor>(0.85, 0.55, 0.25)</nameColor>
    <recoveryMessage>{0}'s insomnia episode has ended.</recoveryMessage>
    <beginLetterLabel>insomnia episode</beginLetterLabel>
    <beginLetter>{0} has fallen into an insomnia episode due to prolonged neurasthenia, wandering uncontrollably for about 2 hours.</beginLetter>
    <beginLetterDef>NegativeEvent</beginLetterDef>
    <baseInspectLine>Mental state: insomnia episode</baseInspectLine>
    <allowBeatfire>true</allowBeatfire>
    <escapingPrisonersIgnore>true</escapingPrisonersIgnore>
  </MentalStateDef>
</Defs>
