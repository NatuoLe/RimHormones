    <defName>MEE_MakeVegFruitJuice</defName>
    <label>make veg-fruit juice</label>
    <description>Juice drinking water with fruit at a fire source.</description>
    <jobString>Making veg-fruit juice.</jobString>
    <workAmount>1000</workAmount>
    <recipeUsers>
      <li>Campfire</li>
      <li>FueledStove</li>
      <li>ElectricStove</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MEE_WaterBottle</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>RawBerries</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
    </ingredients>
    <products>
      <MEE_VegFruitJuice>2</MEE_VegFruitJuice>
    </products>
    <modExtensions>
      <li Class="Hormones.MEERecipeMarker" />
    </modExtensions>
  </RecipeDef>
</Defs>
