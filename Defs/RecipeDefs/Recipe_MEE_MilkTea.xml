<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- 奶茶：水+牛奶（带火建筑）。仅 Metabolic Essential 模块启用时可见 -->
  <RecipeDef>
    <defName>MEE_MakeMilkTea</defName>
    <label>make milk tea</label>
    <description>Brew drinking water with milk at a fire source.</description>
    <jobString>Making milk tea.</jobString>
    <workAmount>1000</workAmount>
    <recipeUsers>
      <li>Campfire</li>
      <li>FueledStove</li>
      <li>ElectricStove</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MEE_WaterBottle</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Milk</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <products>
      <MEE_MilkTea>2</MEE_MilkTea>
    </products>
    <modExtensions>
      <li Class="Hormones.MEERecipeMarker" />
    </modExtensions>
  </RecipeDef>
</Defs>
