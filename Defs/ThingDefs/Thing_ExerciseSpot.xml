<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Simple exercise spot: buildable misc building where colonists perform "exercise" work to improve Physique -->
  <ThingDef ParentName="BuildingBase">
    <defName>Hormones_ExerciseSpot</defName>
    <label>exercise spot</label>
    <description>A simple fitness frame built from wood and stone. Colonists can exercise here to improve their physique over time, enhancing physical endurance and injury recovery. Exercise causes mild fatigue.</description>
    <!-- Using vanilla "crafting spot" texture as placeholder, replaceable with dedicated texture later -->
    <graphicData>
      <texPath>Things/Building/Production/CraftingSpot</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>60</pathCost>
    <blockWind>false</blockWind>
    <fillPercent>0.4</fillPercent>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>1200</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <neverMultiSelect>false</neverMultiSelect>
    <costList>
      <WoodLog>45</WoodLog>
      <Steel>10</Steel>
    </costList>
    <building>
      <isEdifice>false</isEdifice>
    </building>
    <designationCategory>Misc</designationCategory>
    <constructEffect>ConstructMetal</constructEffect>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationHotKey>Misc10</designationHotKey>
    <researchPrerequisites Inherit="False" />
  </ThingDef>

</Defs>
