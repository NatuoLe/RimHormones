<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- 击飞飞行器：短距快速飞行，落地由 PawnFlyer_Knockback 处理眩晕+伤害 -->
  <ThingDef>
    <defName>Hormones_KnockbackFlyer</defName>
    <label>knockback flyer</label>
    <category>Ethereal</category>
    <thingClass>Hormones.PawnFlyer_Knockback</thingClass>
    <useHitPoints>false</useHitPoints>
    <drawOffscreen>true</drawOffscreen>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Skyfaller</altitudeLayer>
    <drawerType>RealtimeOnly</drawerType>
    <selectable>false</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <saveable>Never</saveable>
    <pawnFlyer>
      <!-- 短距离快速飞行：0.2 秒完成，速度 18 -->
      <flightDurationMin>0.15</flightDurationMin>
      <flightSpeed>20</flightSpeed>
      <workerClass>PawnFlyerWorker</workerClass>
      <heightFactor>1.2</heightFactor>
      <progressCurve>
        <points>
          <!-- 快速起飞，前半程已走 40% -->
          <li>(0, 0)</li>
          <li>(0.1, 0.2)</li>
          <li>(1, 1)</li>
        </points>
      </progressCurve>
    </pawnFlyer>
  </ThingDef>
</Defs>
