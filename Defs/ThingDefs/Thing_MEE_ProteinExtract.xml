<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- 蛋白质提取物：代谢扩展模块的蛋白质需求基础资源（占位贴图，后续可换专用贴图） -->
  <ThingDef ParentName="ResourceBase">
    <defName>MEE_ProteinExtract</defName>
    <label>protein extract</label>
    <description>Refined protein. A basic metabolic resource used by the Metabolic Essential module to satisfy the protein need.</description>
    <graphicData>
      <texPath>Things/Item/MEE/MEE_ProteinExtract</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.6,0.6)</drawSize>
    </graphicData>
    <stackLimit>75</stackLimit>
    <thingCategories>
      <li>MEE_Ingredients</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <MarketValue>1.2</MarketValue>
      <Mass>0.05</Mass>
      <Flammability>1</Flammability>
      <Nutrition>0</Nutrition>
    </statBases>
    <!-- 模式 B：补剂非饭（Nutrition=0、preferability=NeverForNutrition，不计入正常饮食）；摄入时由 Comp_MEE_Satisfier 补充蛋白质需求 -->
    <ingestible>
      <preferability>NeverForNutrition</preferability>
      <foodType>AnimalProduct</foodType>
    </ingestible>
    <comps>
      <li Class="Hormones.CompProperties_MEE_Satisfier">
        <needDef>MEEProtein</needDef>
        <satisfyFraction>0.5</satisfyFraction>
      </li>
    </comps>
  </ThingDef>
</Defs>
