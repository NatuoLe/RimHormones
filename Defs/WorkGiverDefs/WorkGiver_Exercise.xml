<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Exercise WorkGiver: scans map for exercise spots and sends colonists to exercise -->
  <WorkGiverDef>
    <defName>Hormones_DoExercise</defName>
    <label>exercise</label>
    <giverClass>Hormones.Jobs.WorkGiver_Exercise</giverClass>
    <workType>Hormones_Exercise</workType>
    <verb>exercise</verb>
    <gerund>exercising at</gerund>
    <priorityInType>50</priorityInType>
    <requiredCapacities>
      <li>Moving</li>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

</Defs>
