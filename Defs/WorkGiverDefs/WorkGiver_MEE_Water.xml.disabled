<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- 让水井/取水机器作为制作台被殖民者执行账单：必须显式绑定 WorkGiver(WorkGiver_DoBill)，
       否则游戏找不到对应 WorkGiver，报 "Can't find a WorkGiver for a BillGiver" 且无人去做装水工作。 -->
  <WorkGiverDef>
    <defName>DoBillsMEEWater</defName>
    <label>draw water</label>
    <giverClass>WorkGiver_DoBill</giverClass>
    <workType>Crafting</workType>
    <priorityInType>50</priorityInType>
    <fixedBillGiverDefs>
      <li>MEE_WaterWell</li>
      <li>MEE_WaterExtractor</li>
    </fixedBillGiverDefs>
    <verb>draw water at</verb>
    <gerund>drawing water at</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <canBeDoneByMechs>false</canBeDoneByMechs>
  </WorkGiverDef>
</Defs>
